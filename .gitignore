# Per-developer Claude Code settings
.claude/settings.local.json

# Node
node_modules/
npm-debug.log*

# macOS
.DS_Store

# Source footage for the hero video. Kept locally for re-cutting; far too large
# to belong in the repo (~105MB), and GitHub rejects single files over 100MB.
*.mov
The Oaks Full Movie.MP4

# Wrangler local state: account cache, build output, dev server data.
.wrangler/

# Playwright MCP scratch output: screenshots, snapshots and console logs.
.playwright-mcp/
__pycache__/

# Local secrets for `wrangler dev` (e.g. ANALYTICS_API_TOKEN). Never committed;
# the live values are Worker secrets set in the Cloudflare dashboard.
.dev.vars
.dev.vars.*

# Generated before every deploy by scripts/stamp-build.mjs.
public/build.json
